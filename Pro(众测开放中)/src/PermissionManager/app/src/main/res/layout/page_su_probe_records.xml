<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp"
    android:paddingTop="0dp">

    <TextView
        android:id="@+id/probe_header_tips_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="记录本次开机内 APP 对 su 文件的探测行为。本功能零性能开销，无侧信道特征。"
        android:textSize="12sp"
        android:textColor="#808080"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/su_probe_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/probe_empty_tips_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="暂无嗅探记录"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:gravity="center"
            android:padding="20dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/probe_loading_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="加载中..."
                android:textSize="14sp"
                android:textColor="#9AA0A6"/>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>

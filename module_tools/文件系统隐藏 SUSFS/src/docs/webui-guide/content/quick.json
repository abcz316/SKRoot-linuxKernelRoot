        },
        {
          "text": "确认挂载路径和作用组，点击「保存规则」。",
          "figure": "mount-editor"
        },
        {
          "text": "点浮动「保存并应用」，再检查挂载记录。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },

        {
          "text": "确认路径和作用组，点击「保存规则」。",
          "figure": "map-editor"
        },
        {
          "text": "点浮动「保存并应用」，再检查映射信息。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "mount": {
      "summary": "隐藏匹配的挂载记录，不会卸载目录或删除文件。",

{
  "intro": {
    "title": "跟着文件页，几步配好 SUSFS",
    "summary": "在文件页点文件或长按目录，通过「设置规则」完成隐藏、属性伪装和重定向；参数细节按需展开。"
  },
  "chapters": {
    "intro": {
      "summary": "先认识文件页和控制台，再从自己的测试文件开始。",
      "steps": [
        {
          "text": "底部「文件」管理对象，「SUSFS」查看和配置规则。",
          "figure": "monitor-overview"
        },
        {
          "text": "先建测试作用组，只选自己的 Probe 应用。",
          "figure": "group-include"
        },
        {
          "text": "点文件或长按目录，从「设置规则」开始。",
          "figure": "file-rule-entry"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "save": {
      "summary": "「保存规则」只改草稿，「保存并应用」才真正提交。",
      "steps": [
        {
          "text": "在规则弹窗确认内容，点击「保存规则」。",
          "figure": "file-rule-path"
        },
        {
          "text": "点击导航栏上方浮出的「保存并应用」。",
          "figure": "file-save-apply"
        },
        {
          "text": "回到监控看结果，再用目标应用重新检查。",
          "figure": "save-applied"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "groups": {
      "summary": "创建一个应用组，再把需要的规则放进这个组。",
      "steps": [
        {
          "text": "进入「作用组」，点「＋ 新建作用组」并命名。",
          "figure": "group-create"
        },
        {
          "text": "展开组卡片，选择「指定模式」。",
          "figure": "group-include"
        },
        {
          "text": "点包名栏的＋，勾选应用并点「确认添加」。",
          "figure": "package-picker"
        },
        {
          "text": "回到规则弹窗，在「作用组」中选这个组。",
          "figure": "file-rule-path"
        },
        {
          "text": "保存规则，再点浮动「保存并应用」。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "identity": {
      "summary": "作用组按真实 UID 生效，共享 UID 的应用一起处理。",
      "steps": [
        {
          "text": "在包名选择器确认自己要设置的应用。",
          "figure": "package-picker"
        },
        {
          "text": "只想影响所选应用时，使用「指定模式」。",
          "figure": "group-include"
        },
        {
          "text": "保存并应用后，用同一个应用重新检查。",
          "figure": "save-applied"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "path": {
      "summary": "让选定应用看不到你指定的文件或目录。",
      "steps": [
        {
          "text": "在文件页点文件或长按目录，打开操作菜单。",
          "figure": "files-select"
        },
        {
          "text": "点击「设置规则」，进入规则弹窗。",
          "figure": "file-rule-entry"
        },
        {
          "text": "选「路径隐藏」和作用组，点击「保存规则」。",
          "figure": "file-rule-path"
        },
        {
          "text": "点浮动「保存并应用」，再检查隐藏结果。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "name": {
      "summary": "输入完整名称，隐藏各处同名文件和目录；不是关键词搜索。",
      "steps": [
        {
          "text": "进入「SUSFS → 规则」，点击「＋ 新建规则」。",
          "figure": "rules-empty"
        },
        {
          "text": "类型选「名称匹配隐藏」，只填完整名称。",
          "figure": "name-editor"
        },
        {
          "text": "选择作用组，点击「保存规则」。",
          "figure": "name-editor"
        },
        {
          "text": "点浮动「保存并应用」，再检查同名项。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "kstat": {
      "summary": "勾选要改的属性，让所选应用看到指定数值。",
      "steps": [
        {
          "text": "在文件页点文件或长按目录，打开操作菜单。",
          "figure": "files-select"
        },
        {
          "text": "点击「设置规则」，类型选「属性伪装」。",
          "figure": "file-rule-kstat"
        },
        {
          "text": "读取当前属性，勾选要改的字段并填值。",
          "figure": "kstat-middle"
        },
        {
          "text": "选作用组并保存规则，再点「保存并应用」。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "redirect": {
      "summary": "把来源 A 的打开转向目标 B；路径模式要求应用能访问 B。",
      "steps": [
        {
          "text": "在文件页找到来源 A，点文件打开操作菜单。",
          "figure": "files-select"
        },
        {
          "text": "点击「设置规则」，类型选「打开重定向」。",
          "figure": "file-rule-entry"
        },
        {
          "text": "选作用组和「路径重定向」，点击选择目标。",
          "figure": "file-rule-redirect"
        },
        {
          "text": "选目标 B，回到弹窗点击「保存规则」。",
          "figure": "target-picker"
        },
        {
          "text": "点浮动「保存并应用」，再重新打开 A 检查。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "content": {
      "summary": "仅 6.12 可用：按来源权限读替代内容；6.6 暂不可选。",
      "steps": [
        {
          "text": "在文件页点来源文件，进入「设置规则」。",
          "figure": "file-rule-entry"
        },
        {
          "text": "选「打开重定向」和「按源权限替换只读内容」。",
          "figure": "redirect-content"
        },
        {
          "text": "选择作用组与目标文件，点击「保存规则」。",
          "figure": "target-picker"
        },
        {
          "text": "点「保存并应用」，让应用重新打开来源。",
          "figure": "file-save-apply"
        }
      ],
      "advancedTitle": "进阶说明与参数"
    },
    "map": {
      "summary": "隐藏所选文件的映射记录；文件仍在，已映射内容也仍在。",
